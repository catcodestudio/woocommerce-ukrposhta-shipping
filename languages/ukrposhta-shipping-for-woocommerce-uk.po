"Plural-Forms: nplurals=3; plural=(n%10==1 && n%100!=11) ? 0 : ((n%10>=2 && n%10<=4 && (n%100<10 || n%100>=20)) ? 1 : 2);\n"
"X-Domain: ukrposhta-shipping-for-woocommerce\n"

msgid "Ukrposhta"
msgstr "Укрпошта"

msgid "Ukrposhta delivery: the customer picks a post office at checkout (region -> city -> office) and the tariff is quoted live."
msgstr "Доставка Укрпоштою: вибір відділення в чекауті (область→місто→відділення) та розрахунок тарифу."

msgid "Enable"
msgstr "Увімкнути"

msgid "Show Ukrposhta at checkout"
msgstr "Показувати «Укрпошта» в чекауті"

msgid "Method title"
msgstr "Назва методу"

msgid "Ukrposhta - delivery to a post office"
msgstr "Укрпошта — доставка у відділення"

msgid "Test environment"
msgstr "Тестове середовище"

msgid "Sandbox (dev.ukrposhta.ua)"
msgstr "Sandbox (dev.ukrposhta.ua)"

msgid "Bearer eCom"
msgstr "Bearer eCom"

msgid "Issued by Ukrposhta once your eCom contract is signed. Needed for both the address classifier and the tariff. Stored encrypted. Leave empty to keep the current key."
msgstr "Видається Укрпоштою після договору. Потрібен для класифікатора адрес і тарифу. Зберігається зашифровано. Залиште порожнім, щоб не змінювати."

msgid "Sender post index"
msgstr "Індекс відправника"

msgid "Post index the parcels are sent from. Required for the tariff."
msgstr "Поштовий індекс складу відправлення — потрібен для тарифу."

msgid "Service type"
msgstr "Тип послуги"

msgid "Ukrposhta Standard"
msgstr "Укрпошта Стандарт"

msgid "Ukrposhta Express"
msgstr "Укрпошта Express"

msgid "Fallback rate, UAH"
msgstr "Тариф за замовчуванням, грн"

msgid "Used when the API is unreachable or no recipient index has been chosen yet."
msgstr "Використовується, коли API недоступний або немає індексу отримувача."

msgid "Free shipping from, UAH"
msgstr "Безкоштовно від суми, грн"

msgid "0 disables it."
msgstr "0 — вимкнено."

msgid "Declared value"
msgstr "Оголошена цінність"

msgid "Send the order total as the declared value"
msgstr "Передавати суму замовлення як оголошену цінність"

msgid "Ukrposhta charges a percentage for this: the quote gets higher, but the parcel is insured."
msgstr "Укрпошта бере за це відсоток — тариф у чекауті буде вищим, зате посилка застрахована."

msgid "Cash-on-delivery payment methods"
msgstr "Способи оплати = післяплата"

msgid "Comma-separated payment method IDs. For these the Ukrposhta cash-on-delivery commission is added to the tariff. The standard WooCommerce method is <code>cod</code>."
msgstr "ID платіжних методів через кому. Для них у тариф додається комісія Укрпошти за післяплату. Стандартний метод WooCommerce — <code>cod</code>."

msgid "Widget accent colour"
msgstr "Акцентний колір віджета"

msgid "Please choose a region, a city and an Ukrposhta post office."
msgstr "Оберіть область, місто і відділення Укрпошти."

msgid "Ukrposhta post office:"
msgstr "Відділення Укрпошти:"

msgid "Ukrposhta was not chosen for this order."
msgstr "Для цього замовлення Укрпошту не обирали."

msgid "City:"
msgstr "Місто:"

msgid "Post office:"
msgstr "Відділення:"

msgid "Post index:"
msgstr "Індекс:"

msgid "Ukrposhta Shipping for WooCommerce requires an active WooCommerce installation."
msgstr "Для роботи плагіна потрібен активний WooCommerce."

msgid "Ukrposhta delivery"
msgstr "Доставка Укрпоштою"

msgid "Region"
msgstr "Область"

msgid "Choose a region…"
msgstr "Оберіть область…"

msgid "City"
msgstr "Місто"

msgid "Choose a region first"
msgstr "Спочатку оберіть область"

msgid "Start typing the name…"
msgstr "Почніть вводити назву…"

msgid "Post office"
msgstr "Відділення"

msgid "Choose a city first"
msgstr "Спочатку оберіть місто"

msgid "Pick a post office or an index…"
msgstr "Оберіть відділення або індекс…"

msgid "Searching…"
msgstr "Пошук…"

msgid "Loading…"
msgstr "Завантаження…"

msgid "Loading regions…"
msgstr "Завантаження областей…"

msgid "Regions are unavailable. Check the connection to Ukrposhta."
msgstr "Області недоступні. Перевірте підключення до Укрпошти."

msgid "Nothing found"
msgstr "Нічого не знайдено"

msgid "No post offices here"
msgstr "Відділень немає"
